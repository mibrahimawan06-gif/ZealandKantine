@page
@model ZealandKantine.Pages.EditProductModel
@{
    ViewData["Title"] = "Ret vare";
}

<h2>✏️ Ret vare</h2>

<form method="post">
    <input type="hidden" asp-for="Product.Id" />
    <input type="hidden" asp-for="Product.IsDrink" />

    <div style="margin-bottom: 10px;">
        <label>Navn:</label><br />
        <input type="text" asp-for="Product.Name" required />
        <span asp-validation-for="Product.Name" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 10px;">
        <label>Beskrivelse:</label><br />
        <input type="text" asp-for="Product.Description" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Pris (kr):</label><br />
        <input type="number" step="0.01" asp-for="Product.Price" required />
        <span asp-validation-for="Product.Price" style="color: red;"></span>
    </div>

    <p style="color: #666; font-size: 14px;">
        Varetypen kan ikke ændres. En ny pris gælder kun fremtidige bestillinger —
        tidligere ordrer beholder den pris, der blev betalt.
    </p>

    <button type="submit" class="btn btn-success">💾 Gem ændringer</button>
    <a href="/" class="btn btn-secondary">⬅️ Tilbage</a>
</form>

<style>
    .btn { padding: 8px 15px; text-decoration: none; color: white; border-radius: 5px; margin: 5px; border: none; cursor: pointer; }
    .btn-success { background: green; }
    .btn-secondary { background: gray; }
    input[type="text"], input[type="number"] { padding: 8px; width: 260px; border: 1px solid #ddd; border-radius: 5px; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
